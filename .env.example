# Copy this file to ".env" and paste your Anthropic API key.
# Get a key at https://console.anthropic.com/account/keys (starts with sk-ant-...).
# StudioKit uses claude-opus-4-8 by default, or override with STUDIOKIT_MODEL.
ANTHROPIC_API_KEY=sk-ant-...
# STUDIOKIT_MODEL=claude-opus-4-8   # default; override if needed
